# Backend URLs - Reemplaza con la IP de tu máquina para desarrollo en red local
# Para desarrollo solo en tu máquina: usa localhost
# VITE_SHOP=http://localhost:5000/shop
# VITE_PRODUCT=http://localhost:5000/api/product
# VITE_CATEGORY=http://localhost:5000/api/category

# Para desarrollo en red local (LAN) - reemplaza con tu IP local
# Puedes encontrar tu IP con 'ipconfig' en Windows o 'ifconfig' en Linux/Mac
VITE_SHOP=http://192.168.100.47:5000/shop
VITE_PRODUCT=http://192.168.100.47:5000/api/product
VITE_CATEGORY=http://192.168.100.47:5000/api/category

# Para producción - reemplaza con tu dominio o IP pública
# VITE_SHOP=https://api.tudominio.com/shop
# VITE_PRODUCT=https://api.tudominio.com/api/product
# VITE_CATEGORY=https://api.tudominio.com/api/category